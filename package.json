    "zod": "^3.22.4",
    "@langchain/core": "^0.1.0",
    "@langchain/openai": "^0.0.0",
    "@langchain/anthropic": "^0.0.0",
    "langchain": "^0.1.0",
    "ioredis": "^5.4.1",
    "uuid": "^9.0.1",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.10",
    "@types/pg": "^8.10.9",
