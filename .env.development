NODE_ENV=development
APP_NAME=AI Smart Interviewer
APP_URL=http://localhost:3000
PORT=3000
WS_PORT=3001
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=sk-your-api-key
EMBEDDING_MODEL=text-embedding-3-small
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ai_interviewer
DB_SSL=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_KEY_PREFIX=ai_interviewer:
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./uploads
JWT_SECRET=replace-with-32-char-min-secret-000000
JWT_REFRESH_SECRET=replace-with-32-char-min-refresh-0000
LOG_LEVEL=info
LOG_FORMAT=pretty
LOG_OUTPUT=stdout
